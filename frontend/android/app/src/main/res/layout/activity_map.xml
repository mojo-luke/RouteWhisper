<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapbox MapView (full screen background) -->
    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Maneuver View - Turn-by-turn instructions at top -->
    <com.mapbox.navigation.ui.components.maneuver.view.MapboxManeuverView
        android:id="@+id/maneuverView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp" />

    <!-- Budget chip - "X / Y min slack". Set by Flutter via method channel
         whenever WaypointManager budget state changes. Hidden by default. -->
    <TextView
        android:id="@+id/budgetChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/maneuverView"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        android:textColor="#7BE08F"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/budget_chip_bg"
        android:text="0 / 60 min slack" />

    <!-- Waypoint Progress Card - Shows next waypoint info (Google Maps style) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/waypointProgressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/maneuverView"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Waypoint name -->
            <TextView
                android:id="@+id/waypointNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next stop: Shell Gas Station"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <!-- Distance and ETA row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Distance -->
                <TextView
                    android:id="@+id/waypointDistanceText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2.3 mi"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray" />

                <!-- ETA -->
                <TextView
                    android:id="@+id/waypointEtaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 min"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray" />

                <!-- Stop indicator -->
                <TextView
                    android:id="@+id/waypointStopIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Stop 1 of 3"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Trip Progress View - ETA/distance at bottom -->
    <com.mapbox.navigation.ui.components.tripprogress.view.MapboxTripProgressView
        android:id="@+id/tripProgressView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp" />

    <!-- Find Stops Button - Open POI discovery during navigation -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/findStopsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/tripProgressView"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="Find stops along route"
        android:src="@android:drawable/ic_menu_search"
        android:backgroundTint="@android:color/holo_blue_dark" />

    <!-- Suggest-a-Stop Button - Force a proactive recommendation poll -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/suggestStopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/findStopsButton"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Suggest a stop now"
        android:src="@android:drawable/ic_menu_compass"
        android:backgroundTint="#FB8C00" />

    <!-- Recenter Button - Floating action button to return to following mode -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/recenterButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/tripProgressView"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/recenter_camera"
        android:src="@android:drawable/ic_menu_mylocation"
        android:visibility="gone" />

    <!-- Recommendation banner - bottom-anchored card with category icon,
         name, reason, "Not now" + "Add stop" buttons. Set by Flutter via
         method channel when RecommendationService surfaces a suggestion. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/recommendationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/tripProgressView"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardElevation="8dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#252525">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/recommendationIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:text="📍" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recommendationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:text="Place name" />

                    <TextView
                        android:id="@+id/recommendationReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"
                        android:text="Suggested reason" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/recommendationDismissButton"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Not now"
                    android:textColor="@android:color/white"
                    android:background="@drawable/recommendation_button_outline" />

                <Button
                    android:id="@+id/recommendationAcceptButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_marginStart="10dp"
                    android:text="Add stop"
                    android:textColor="@android:color/white"
                    android:background="@drawable/recommendation_button_filled" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Flutter overlay container for POI discovery -->
    <FrameLayout
        android:id="@+id/flutterContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000" />

</RelativeLayout>
