<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary "Add stop" button on the recommendation banner. Filled blue
  with rounded corners; pressed/disabled states inherit defaults.
  Kept lightweight (no Material theme dependency) to avoid forcing
  Theme.MaterialComponents on the whole activity.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1976D2" />
    <corners android:radius="10dp" />
</shape>
