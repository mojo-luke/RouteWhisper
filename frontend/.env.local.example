# Copy to .env.local (gitignored) and fill in your values.
# Used by scripts/run.sh.

# From Supabase → Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# From Supabase → Settings → API → anon public
SUPABASE_ANON_KEY=eyJ...

# From Google Cloud → APIs & Services → Credentials → Web OAuth client
GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxx.apps.googleusercontent.com
